{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "description": "REST API của Vietnam Event GIS (Node.js + Express + PostgreSQL/PostGIS)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node --env-file=.env dist/index.js",
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.check.json",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:load-boundaries": "tsx --env-file=.env scripts/load-boundaries.ts",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:load-boundaries && npm run db:seed",
    "test": "tsx --env-file=.env --test test/*.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
